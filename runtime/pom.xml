<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.quarkpress</groupId>
    <artifactId>quarkpress-admin-gutenberg-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>quarkpress-admin-gutenberg</artifactId>

  <name>QuarkPress Admin Gutenberg :: Runtime</name>
  <description>The QuarkPress admin shell and WordPress's block editor</description>

  <properties>
    <automatic.module.name>org.quarkpress.admin</automatic.module.name>
    <!-- Where the build keeps the two downloads between builds, and the program that copies the listed files. -->
    <admin.download.cache>${user.home}/.m2/repository/.cache/quarkpress-admin</admin.download.cache>
    <admin.copier>${project.basedir}/src/build/org/quarkpress/admin/build/AssetCopier.java</admin.copier>
    <admin.resources>${project.build.outputDirectory}/org/quarkpress/admin</admin.resources>
  </properties>

  <dependencies>
    <!-- The core module, so that the deployment side may declare the module's configuration keys through the core's
         build items: the extension plugin refuses a deployment that reaches a runtime extension its runtime lacks. -->
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-core</artifactId>
    </dependency>
    <!-- The REST API the shell and the editor talk to, and its configured path. -->
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-rest-wp-v2</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-vertx-http</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The pinned WordPress release and oidc-client-ts tarball, each checked against its SHA-256. Declared before
           the copier: Maven runs one phase's executions in declaration order. -->
      <plugin>
        <groupId>com.googlecode.maven-download-plugin</groupId>
        <artifactId>download-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>download-wordpress</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>wget</goal>
            </goals>
            <configuration>
              <uri>https://wordpress.org/wordpress-${wordpress.version}.zip</uri>
              <sha256>${wordpress.sha256}</sha256>
              <outputDirectory>${project.build.directory}/downloads</outputDirectory>
              <cacheDirectory>${admin.download.cache}</cacheDirectory>
            </configuration>
          </execution>
          <execution>
            <id>download-oidc-client-ts</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>wget</goal>
            </goals>
            <configuration>
              <uri>https://registry.npmjs.org/oidc-client-ts/-/oidc-client-ts-${oidc-client-ts.version}.tgz</uri>
              <sha256>${oidc-client-ts.sha256}</sha256>
              <unpack>true</unpack>
              <outputDirectory>${project.build.directory}/downloads/oidc-client-ts</outputDirectory>
              <cacheDirectory>${admin.download.cache}</cacheDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Copies the files the lists name into the jar's resources; the WordPress zip's digest is checked again first.
           A missing file or another digest fails the build before anything is copied. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-wordpress-files</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${java.home}/bin/java</executable>
              <arguments>
                <argument>--source</argument>
                <argument>21</argument>
                <argument>${admin.copier}</argument>
                <argument>${project.basedir}/src/main/resources/org/quarkpress/admin/wordpress-files.txt</argument>
                <argument>${project.build.directory}/downloads/wordpress-${wordpress.version}.zip</argument>
                <argument>${admin.resources}/wp</argument>
                <argument>${wordpress.sha256}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>copy-oidc-client-ts-files</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${java.home}/bin/java</executable>
              <arguments>
                <argument>--source</argument>
                <argument>21</argument>
                <argument>${admin.copier}</argument>
                <argument>${project.basedir}/src/main/resources/org/quarkpress/admin/oidc-client-ts-files.txt</argument>
                <argument>${project.build.directory}/downloads/oidc-client-ts</argument>
                <argument>${admin.resources}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- The copier is a test source too, so that its tests call it directly. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-copier-test-source</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>src/build</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- spotless:apply and spotless:check also cover the build-time copier. -->
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <configuration>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
              <include>src/build/**/*.java</include>
            </includes>
          </java>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>io.quarkus</groupId>
              <artifactId>quarkus-extension-processor</artifactId>
              <version>${quarkus.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-extension-maven-plugin</artifactId>
        <configuration>
          <capabilities>
            <provides>org.quarkpress.admingutenberg</provides>
          </capabilities>
        </configuration>
      </plugin>
      <plugin>
        <groupId>io.smallrye</groupId>
        <artifactId>jandex-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
