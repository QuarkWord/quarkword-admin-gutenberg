  <artifactId>quarkpress-admin-gutenberg-integration-tests</artifactId>

  <name>QuarkPress Admin Gutenberg :: Integration tests</name>
  <description>A network application with every M2 module, Keycloak and the admin extension, whose admin screens are driven in a real browser (Playwright, Chromium headless) in JVM mode, and as a native executable in CI. Never published.</description>

  <properties>
    <automatic.module.name>org.quarkpress.it.admin</automatic.module.name>
    <maven.deploy.skip>true</maven.deploy.skip>
    <skipUnitTests>false</skipUnitTests>
    <!-- Quarkus adds its own JVM flags to @{argLine}; empty when nothing sets it. -->
    <argLine></argLine>
    <!-- JVM flags for the application that @QuarkusIntegrationTest starts (JVM mode only; empty for native). -->
    <it.app.argLine>${surefire.argLine.additional}</it.app.argLine>
  </properties>

  <dependencies>
