      <artifactId>quarkpress-persistence-deployment</artifactId>
      <version>${quarkpress.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-rest-wp-v2-deployment</artifactId>
      <version>${quarkpress.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
