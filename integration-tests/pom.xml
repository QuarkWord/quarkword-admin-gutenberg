      <version>${quarkpress.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-media</artifactId>
      <version>${quarkpress.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-media-storage-fs</artifactId>
      <version>${quarkpress.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-media-image-imageio</artifactId>
      <version>${quarkpress.version}</version>
    </dependency>
    <dependency>
      <groupId>org.quarkpress</groupId>
      <artifactId>quarkpress-admin-gutenberg</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-mysql</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-test-keycloak-server</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.microsoft.playwright</groupId>
      <artifactId>playwright</artifactId>
      <version>${playwright.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Make the reactor (or the local repository) provide the deployment modules before this application. -->
